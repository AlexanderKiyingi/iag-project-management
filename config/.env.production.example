# Production — project management API (behind iag-api-gateway).
PORT=4102
# ADDR=:4102
GIN_MODE=release
LOG_LEVEL=info
LOG_FORMAT=json

DATABASE_URL=postgres://svc_iag_pm:PASSWORD@HOST:5432/iag_platform?sslmode=require
REDIS_URL=redis://redis:6379/2
AUTO_MIGRATE=true

AUTH_MODE=gateway
GATEWAY_INTERNAL_SECRET=change-me-in-production-min-16-chars
JWT_ISSUER=https://auth.example.com
JWKS_URL=https://auth.example.com/.well-known/jwks.json
GATEWAY_API_PREFIX=/api/v1/project-management
PUBLIC_API_URL=https://api.example.com
CORS_ORIGIN=https://app.example.com

EVENT_BUS_ENABLED=true
KAFKA_BROKERS=kafka-broker-1:9092,kafka-broker-2:9092
PM_UPLOAD_DIR=/var/lib/pm-uploads
