# Local development — see config/.env.production.example for production.
# Copy to .env in this directory or export in your shell.

PORT=4102
# ADDR=:4102
GIN_MODE=debug
LOG_LEVEL=info
LOG_FORMAT=text

DATABASE_URL=postgres://svc_iag_pm:iag_pm_dev@localhost:5432/iag_platform?sslmode=disable
REDIS_URL=redis://localhost:6379/2
AUTO_MIGRATE=true

# Hard cutover: every request must carry a Bearer JWT with aud=iag.project-management.
# AUTH_MODE and GATEWAY_INTERNAL_SECRET no longer exist.
JWT_ISSUER=http://localhost:3001
JWKS_URL=http://127.0.0.1:3001/.well-known/jwks.json
AUDIENCE=iag.project-management

# Service account for permission registration with iag-authentication and outbound calls.
SERVICE_CLIENT_ID=iag-project-management
SERVICE_CLIENT_SECRET=dev-pm-secret-bootstrap
AUTH_TOKEN_URL=http://127.0.0.1:3001/oauth/token

PUBLIC_API_URL=http://localhost:8080
GATEWAY_API_PREFIX=/api/v1/project-management
CORS_ORIGIN=http://localhost:3000

EVENT_BUS_ENABLED=true
KAFKA_BROKERS=localhost:19092
PM_UPLOAD_DIR=./data/pm-uploads

# Optional email alerts (consumed by iag-notifications via pm.alert.raised / pm.task.assigned / pm.mention.created)
NOTIFY_DEFAULT_RECIPIENT=ops@iag.local
NOTIFY_CHANNEL=email

# Scheduled jobs (cmd/jobs --reminders)
TASK_DUE_REMINDER_DAYS=7
