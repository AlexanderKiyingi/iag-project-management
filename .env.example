# Local development — see config/.env.production.example for production.
# Copy to .env in this directory or export in your shell.

ADDR=:4102
GIN_MODE=debug
LOG_LEVEL=info
LOG_FORMAT=text

DATABASE_URL=postgres://iag:iag_dev@localhost:5432/iag_pm?sslmode=disable
REDIS_URL=redis://localhost:6379/2
AUTO_MIGRATE=true

# gateway (docker compose) or jwt (direct to API, bypass gateway)
AUTH_MODE=gateway
GATEWAY_INTERNAL_SECRET=dev-gateway-secret-min-16-chars
JWT_ISSUER=http://localhost:3001
JWKS_URL=http://127.0.0.1:3001/.well-known/jwks.json

PUBLIC_API_URL=http://localhost:8080
GATEWAY_API_PREFIX=/api/v1/project-management
CORS_ORIGIN=http://localhost:3000

EVENT_BUS_ENABLED=true
KAFKA_BROKERS=localhost:19092
PM_UPLOAD_DIR=./data/pm-uploads
